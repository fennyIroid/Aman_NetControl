    <!--
        Every privileged access this app uses is declared here explicitly. A permission that is
        treated as silently available is one nobody reviews, and the manifest is the first place
        that has to be honest.
    -->

    <!-- App restriction, AI and game budgets: foreground app detection and per-app time.
         Usage Access is a special access granted in Settings; declaring it is what makes this
         app appear in that Settings list at all. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Full installed-app enumeration. A restricted permission: Play requires a declared and
         justified use case, and parental control is an accepted one. The <queries> block below
         is the fallback that works without it. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- VPN restriction and ad removal: reading network state, and the tunnel itself. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The block screen, the surface notice and the video blur layer. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Parent alerts, and the ongoing notice a foreground service must show. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keeping enforcement alive across reboots, updates and idle periods. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Protection health: knowing that Android's Advanced Protection Mode, not a child, is what
         withdrew accessibility access. A normal permission; Android 16 and later. -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Clone control: reading profile information across user spaces. -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_PROFILES"
        tools:ignore="ProtectedPermissions" />

    <!--
        Package visibility declarations (Android 11+).

        Without these, a targeted check for a known app returns "not installed" even when it is.
        Every package in the curated list appears here, which is also why that list has to stay
        proportionate: the manifest is a public statement of what this app looks for.
    -->
