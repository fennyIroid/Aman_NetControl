    <application
        android:name=".ChildSafetyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChildSafety"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ChildSafety.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The screen capture consent window.

            Android only shows that dialog over an Activity and only accepts the answer for one
            session, so this exists to be opened from a notification or the permissions list and
            closed again immediately.
        -->
        <activity
            android:name=".platform.projection.CaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ChildSafety.Invisible" />

        <!--
            The enforcement loop.

            specialUse is the honest declaration for continuous usage-stat polling; Android 14
            requires the type and Play reviews the justification string.
        -->
        <service
            android:name=".platform.enforcement.MonitoringService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous child-safety enforcement of app restrictions, time limits and bypass detection." />
        </service>

        <!--
            Internet Pause, and nothing else. Filtering runs through Android's Private DNS with
            no tunnel; this is raised only while a parent has the internet paused, holds the VPN
            slot so nothing can be carried, and goes away when the pause is lifted.
            BIND_VPN_SERVICE is enforced by the system.
        -->
        <service
            android:name=".platform.network.PauseTunnelService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parent-requested internet pause: holds the VPN slot and carries nothing while paused." />
        </service>

        <!--
            Video blurring: frame sampling and on-device classification.

            stopWithTask is declared rather than left to the default on every enforcement service
            here, because the default is the one thing a child will try. Swiping the app out of
            recents must not be how a protection gets switched off, and a service that stops with
            its task is exactly that. It is stated explicitly so nobody has to remember which way
            the platform default falls, and so a review of this file can see the intent.
        -->
        <service
            android:name=".platform.projection.ScreenAnalysisService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
            Screen-level detection and enforcement: Shorts and Reels, Status and Stories, AI
            conversations, and the system VPN screen.

            BIND_ACCESSIBILITY_SERVICE is enforced by the system, and Play requires a declared
            accessibility purpose. This is the most policy-sensitive declaration in the app.
        -->
        <service
            android:name=".platform.accessibility.SafetyAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Communication signals from message notifications. -->
        <service
            android:name=".platform.notification.SafetyNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Device admin.

            This only makes uninstall require deactivation first, which is a real deterrent
            against a child simply removing the app. Full policy control needs Device Owner,
            which cannot be granted to an app installed from the Play Store.
        -->
        <receiver
            android:name=".platform.admin.SafetyDeviceAdminReceiver"
            android:exported="true"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Restarts enforcement after a reboot or an update, if the parent had it on. -->
        <receiver
            android:name=".platform.enforcement.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
